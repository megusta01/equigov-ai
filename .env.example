# Copie para .env e troque as senhas. O .env nunca vai para o Git.
DB_NAME=equigov
DB_USER=equigov
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

WP_ENV=local
# 1 liga o modo debug; vazio desliga
WP_DEBUG=1
WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=troque-admin
WP_ADMIN_EMAIL=admin@equigov.local

HTTP_PORT=8080

# Serviço de IA
AI_SERVICE_URL=http://ai-service:8000
# Token compartilhado WordPress <-> serviço de IA (mínimo 16 caracteres, aleatório)
AI_SERVICE_TOKEN=troque-por-um-token-longo-e-aleatorio
AI_PORT=8001

# LLM: qualquer API no formato OpenAI. Padrão: Groq (plano gratuito em console.groq.com)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# hybrid = BM25 + embeddings locais | bm25 = só busca lexical
RETRIEVAL_MODE=hybrid
