{
    "name": "gustavofigueredo/equigov-core",
    "description": "Plugin WordPress do EquiGov AI",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "EquiGov\\Core\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "EquiGov\\Core\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
